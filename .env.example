DISCORD_TOKEN=
GUILD_ID=1553454072110129152
COMMAND_PREFIX=,
DATABASE_URL=postgresql+asyncpg://discordbot:discordbot@localhost:5432/discordbot
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=discordbot
POSTGRES_PASSWORD=
POSTGRES_DB=discordbot
REDIS_MAX_CONNECTIONS=100
CACHE_TTL_SECONDS=600
REDIS_LOCK_TTL_MS=5000
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=5000
METRICS_HOST=0.0.0.0
METRICS_PORT=9100
HEALTH_PORT=8080
GREETING_QUEUE_SIZE=1000
GREETING_WORKERS=4
GREETING_MAX_EVENT_AGE=30
INVITE_JOIN_QUEUE_SIZE=2000
INVITE_STAT_FLUSH_INTERVAL=1.0
SHARD_COUNT=
SHARD_IDS=
OTEL_EXPORTER_OTLP_ENDPOINT=
PUBLIC_BASE_URL=http://localhost:8080
DASHBOARD_API_KEY=
LAVALINK_URL=
LAVALINK_PASSWORD=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8081
# Distributed gateway workers
GATEWAY_QUEUE_SIZE=4096
GATEWAY_WORKERS=8
# In multi-pod mode, each pod MUST have a unique INSTANCE_ID and non-overlapping SHARD_IDS.
INSTANCE_ID=
SHARD_LEASE_TTL_MS=30000

# Graceful shutdown: time allowed for accepted gateway events to drain
GATEWAY_SHUTDOWN_TIMEOUT=15

# Production DB pooling: point DATABASE_URL at PgBouncer and enable this.
DB_USE_PGBOUNCER=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
GATEWAY_GUILD_CONCURRENCY=1
# Gateway overload protection: total queue and reserved command/security queue.
GATEWAY_QUEUE_SIZE=4096
GATEWAY_CRITICAL_QUEUE_SIZE=1024
# When true, DATABASE_URL should point at PgBouncer's transaction port (6432).
DB_USE_PGBOUNCER=false

LOG_LEVEL=INFO
ENVIRONMENT=development
OTEL_ENABLED=false
OTEL_SERVICE_NAME=titan-discord-bot
# Decaying multi-factor moderation heat
AUTOMOD_HEAT_DECAY=0.08
AUTOMOD_HEAT_TTL=900
